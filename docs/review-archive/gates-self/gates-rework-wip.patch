new file mode 100644
index 0000000..acd35bd
--- /dev/null
+++ b/tools/gates/repo.py
@@ -0,0 +1,111 @@
+"""The repository the shells read and write: its root, git, stdout, and the baseline file, checked
+against its schema and parsed once on load into a `Baseline`, and written back the same way."""
+
+from __future__ import annotations
+
+import io
+import json
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from baseline import Baseline, Raise
+from common import BASELINE_NAME
+from defaults import (
+    DEFAULT_LAYERS,
+    DEFAULT_LIMITS,
+    DEFAULT_PYTHON_TOOL,
+    EXCEPTION_GATES,
+    LIMIT_KEYS,
+    PYTHON_TOOL,
+)
+from schema import problems
+
+ROOT = Path(__file__).resolve().parents[2]
+BASELINE = ROOT / BASELINE_NAME
+
+
+@dataclass(frozen=True)
+class Invalid:
+    """The baseline file doesn't match its schema; `problems` says where."""
+
+    problems: list[str]
+
+    def message(self) -> str:
+        return "\n".join([f"{BASELINE.name} is invalid:", *(f"  {p}" for p in self.problems)])
+
+
+def _raise(e: dict[str, Any]) -> Raise:
+    """An entry (a base revision's may lack keys: those read as empty)."""
+    what, reason, date = (str(e.get(key, "")) for key in ("what", "reason", "date"))
+    return Raise(date, what, (e.get("from"), e.get("to")), reason, e)
+
+
+def parse(raw: dict[str, Any]) -> Baseline:
+    """A baseline from its JSON, with what it leaves out filled with the strictest value (a missing
+    cap is 0). A base revision's older baseline may hold one suppression total: it compares as no
+    per-file caps."""
+    allowed, limits = raw.get("allowed", {}), raw.get("limits", {})
+    suppressions, exceptions = allowed.get("suppressions", {}), raw.get("exceptions", {})
+    return Baseline(
+        version=raw.get("version", 1),
+        layers={k: tuple(v) for k, v in raw.get("layers", DEFAULT_LAYERS).items()},
+        limits=DEFAULT_LIMITS | {k: v for k, v in limits.items() if k != PYTHON_TOOL},
+        python_tool=limits.get(PYTHON_TOOL, DEFAULT_PYTHON_TOOL),
+        uncapped={k: tuple(v) for k, v in allowed.get("uncapped", {}).items()},
+        defensive=allowed.get("defensive", {}),
+        suppressions=suppressions if isinstance(suppressions, dict) else {},
+        raw_tags=allowed.get("raw_tags", {}),
+        exceptions={gate: exceptions.get(gate, {}) for gate in EXCEPTION_GATES},
+        raises=tuple(_raise(e) for e in raw.get("raises", [])),
+    )
+
+
+def load() -> Baseline | Invalid:
+    """The baseline, checked and parsed; with no file, the strictest one."""
+    if not BASELINE.exists():
+        return parse({})
+    raw = json.loads(BASELINE.read_text(encoding="utf-8"))
+    found = problems(raw)
+    return Invalid(found) if found else parse(raw)
+
+
+def save(b: Baseline) -> None:
+    limits = {k: b.python_tool if k == PYTHON_TOOL else b.limits[k] for k in LIMIT_KEYS}
+    allowed = {
+        "uncapped": b.uncapped,
+        "defensive": b.defensive,
+        "suppressions": b.suppressions,
+        "raw_tags": b.raw_tags,
+    }
+    raw = {"version": b.version, "layers": b.layers, "limits": limits, "allowed": allowed}
+    raw |= {"exceptions": b.exceptions, "raises": [r.entry for r in b.raises]}
+    BASELINE.write_text(json.dumps(raw, indent=2) + "\n", encoding="utf-8", newline="\n")
+
+
+def git(*args: str) -> str | None:
+    result = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=False)
+    return result.stdout if result.returncode == 0 else None
+
+
+def at_revision(rev: str) -> Baseline | None:
+    """The baseline committed at `rev`, parsed (not schema-checked: it may be older)."""
+    committed = git("show", f"{rev}:{BASELINE.name}")
+    return None if committed is None else parse(json.loads(committed))
+
+
+def base_revision(ref: str | None) -> tuple[str, str] | None:
+    """The revision to compare the baseline with, and how to name it; None if `ref` is unknown."""
+    if ref is None:
+        return "HEAD", "HEAD"
+    merge_base = git("merge-base", "HEAD", ref)
+    if merge_base is None:
+        return None
+    return merge_base.strip(), f"the merge base with {ref} ({merge_base[:7]})"
+
+
+def utf8_stdout() -> None:
+    if isinstance(sys.stdout, io.TextIOWrapper):
+        sys.stdout.reconfigure(encoding="utf-8")  # a Windows pipe may not be UTF-8
diff --git a/tools/gates/report.py b/tools/gates/report.py
new file mode 100644
index 0000000..ea204a2
--- /dev/null
+++ b/tools/gates/report.py
@@ -0,0 +1,134 @@
+"""The lines the shells print: `just gates`' report, the raises to approve, and `just card`'s
+markdown (what a branch did to the gate numbers: the base revision's baseline against the working
+one with the ratchet applied)."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+
+from baseline import Baseline, Json, covers, flatten, new_raises, raised
+from common import layer_of
+from defaults import EXCEPTION_GATES
+from measures import Measures
+from results import Result
+
+SHOWN = 25  # improvements listed before "+N more"
+
+
+def report(
+    results: list[Result], m: Measures, seconds: float, can_ratchet: bool, approve: list[str]
+) -> Iterator[str]:
+    yield f"gates: {m.files} files in {seconds:.1f} s"
+    for r in results:
+        yield f"  {'ok  ' if r.ok else 'FAIL'} {r.name:<15} {r.summary}"
+        yield from (f"         {line}" for line in r.details)
+        if not r.ok and r.hint:
+            yield f"         fix: {r.hint}"
+    yield from approve
+    if can_ratchet:
+        yield "ratchet available: run `just ratchet`"
+    failed = [r.name for r in results if not r.ok]
+    yield f"FAIL: {', '.join(failed)}" if failed else "PASS"
+
+
+def to_approve(baseline: Baseline, base: Baseline | None, label: str) -> list[str]:
+    """The `raises` entries that aren't in the base revision's baseline, one line each."""
+    entries = new_raises(base, baseline) if base else baseline.raises
+    if not entries:
+        return []
+    lines = [f"raises to approve ({len(entries)} not in the baseline at {label}):"]
+    for e in entries:
+        lines.append(f"  {e.date}  {e.what}: {e.span[0]} -> {e.span[1]}")
+        lines.append(f"      {e.reason}")
+    return lines
+
+
+def _cell(before: int | None, after: int | None) -> str:
+    if before == after:
+        return "-" if before is None else str(before)
+    mark = " ▼" if (after or 0) < (before or 0) else " ▲"
+    return f"{'-' if before is None else before} → {'-' if after is None else after}{mark}"
+
+
+def _defensive(baseline: Baseline, layer: str) -> int:
+    caps = baseline.defensive
+    return sum(sum(k.values()) for p, k in caps.items() if layer_of(p, baseline.layers) == layer)
+
+
+def summary(before: Baseline, after: Baseline) -> list[str]:
+    """One row per gate: named offenders, worst named score and their total (▼ better, ▲ worse)."""
+    rows = ["| Gate | Named | Worst | Total |", "|---|---|---|---|"]
+    for gate in EXCEPTION_GATES:
+        b, a = before.exceptions[gate], after.exceptions[gate]
+        worst = _cell(max(b.values(), default=None), max(a.values(), default=None))
+        total = _cell(sum(b.values()), sum(a.values()))
+        rows.append(f"| {gate} | {_cell(len(b), len(a))} | {worst} | {total} |")
+    for layer in {**before.layers, **after.layers}:  # before's layers, then any new ones
+        total = _cell(_defensive(before, layer), _defensive(after, layer))
+        rows.append(f"| defensive ({layer}) | | | {total} |")
+    for section, b, a in (
+        ("suppressions", before.suppressions, after.suppressions),
+        ("raw_tags", before.raw_tags, after.raw_tags),
+    ):
+        rows.append(f"| {section} | | | {_cell(sum(b.values()), sum(a.values()))} |")
+    return rows
+
+
+def _label(key: str) -> str:
+    """`exceptions.cognitive.a.py::f` -> `cognitive  a.py::f`."""
+    section, _, rest = key.removeprefix("exceptions.").removeprefix("allowed.").partition(".")
+    return f"{section}  {rest}" if rest else section
+
+
+def improved(before: Baseline, after: Baseline, now: dict[str, int]) -> list[str]:
+    """Each number that went down, biggest gain first; `now` gives a removed offender's score."""
+    b, a = flatten(before), flatten(after)
+    found: list[tuple[int, str]] = []
+    for key, old in b.items():
+        if key in a and a[key] >= old:
+            continue
+        new = a.get(key, now.get(key, 0))
+        gone = "" if key in a else " (removed)"
+        found.append((new - old, f"`{_label(key)}`  {old} → {new}{gone}"))
+    lines = [line for _, line in sorted(found)]  # the biggest gain first
+    more = [f"- +{len(lines) - SHOWN} more"] if len(lines) > SHOWN else []
+    return [f"- {line}" for line in lines[:SHOWN]] + more
+
+
+def worse(before: Baseline, after: Baseline) -> list[str]:
+    """Each number that went up, with the `raises` entry that names it (if any)."""
+    b, a = flatten(before), flatten(after)
+    entries = new_raises(before, after)
+    lines: list[str] = []
+    for key in raised(before, after):
+        entry = next((e for e in entries if covers(e.what, key)), None)
+        why = f"raises `{entry.what}`: {entry.reason}" if entry else "no raises entry"
+        lines.append(f"- `{_label(key)}`  {b.get(key, '-')} → {a.get(key, 'changed')}; {why}")
+    return lines
+
+
+def _escape(value: Json) -> str:
+    return str(value).replace("|", "\\|").replace("\n", " ")
+
+
+def raises_table(before: Baseline, after: Baseline) -> list[str]:
+    rows = ["| What | From → to | Reason |", "|---|---|---|"]
+    for e in new_raises(before, after):
+        span = f"{_escape(e.span[0])} → {_escape(e.span[1])}"
+        rows.append(f"| `{_escape(e.what)}` | {span} | {_escape(e.reason)} |")
+    return rows if len(rows) > 2 else []
+
+
+def card(before: Baseline, after: Baseline, now: dict[str, int], verdict: str) -> list[str]:
+    better, up, table = (
+        improved(before, after, now),
+        worse(before, after),
+        raises_table(before, after),
+    )
+    unchanged = [] if better or up or table else ["", "No change to the gate numbers."]
+    sections = [("Improved", better), ("Worse", up), ("Raises to approve", table)]
+    out = [verdict, *unchanged, "", *summary(before, after)]
+    for title, lines in sections:
+        if lines:
+            out += ["", f"### {title}", "", *lines]
+    return out
