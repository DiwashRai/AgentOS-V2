+  height: var(--tally-seg);
+}
+.stage::before {
+  content: "";
+  position: absolute;
+  inset: calc(50% - var(--line-1)) 0 auto;
+  height: var(--line-2);
+  border-radius: var(--r-pill);
+  background: var(--tally-rail);
+}
+.stage > .seg {
+  flex: 0 1 var(--tally-unit);
+  min-width: var(--sp-2);
+  height: auto;
+  border-radius: var(--r-pill);
+}
+.stage > [data-kind="you"] {
+  background: var(--you);
+}
+.stage > [data-kind="blk"] {
+  background: var(--blocked);
+}
+.stage > [data-kind="run"] {
+  background: var(--live);
+}
+.stage > [data-kind="wait"] {
+  background: var(--tally-grey);
+}
+/* queued: dashes, as a queued run's track */
+.stage > [data-kind="queued"] {
+  background: repeating-linear-gradient(
+    90deg,
+    var(--tally-grey) 0 var(--sp-2),
+    transparent var(--sp-2) calc(var(--sp-2) + var(--line-2))
+  );
+}
+.stage > [data-kind="done"] {
+  background: var(--done);
+}
+.stage > [data-kind="abandoned"] {
+  background: var(--ink-3);
+}
+.stage > [data-kind="idle"] {
+  background: none;
+  box-shadow: inset 0 0 0 var(--line-1) var(--ink-3);
+}
