+++ b/web/src/features/queue/model.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from "vitest";
+
+import type { RailStep, StepState } from "../../api/types";
+import { trail } from "./model";
+
+const step = (name: string, state: StepState, more: Partial<RailStep> = {}): RailStep => ({
+  stage_id: name.toLowerCase(),
+  name,
+  state,
+  gate: null,
+  round: null,
+  ...more,
+});
+
+const running = { kind: "running", run_id: 1, agent: "Builder", step: "", progress: null } as const;
+
+describe("a running run's trail", () => {
+  it("is the stage it finished, the one under way and the next, skipped stages left out", () => {
+    const rail = [
+      step("Implement", "done"),
+      step("Lint", "skipped"),
+      step("Review", "current", { round: { n: 2, of: 3 } }),
+      step("Open a PR", "pending"),
+    ];
+    expect(trail({ rail, phase: "review", attention: running }, null)).toEqual([
+      { text: "Implement", state: "done" },
+      { text: "Review", state: "now", round: "Round 2 of 3" },
+      { text: "Open a PR", state: "next" },
+    ]);
+  });
+  it("ends at the gate the stage under way stops at", () => {
+    const gate = { label: "Plan sign-off", short: "Sign-off", state: "pending" } as const;
+    const rail = [step("Plan", "current", { gate }), step("Implement", "pending")];
+    expect(trail({ rail, phase: "plan", attention: running }, null)).toEqual([
+      { text: "Inbox", state: "done" },
+      { text: "Plan", state: "now" },
+      { text: "Plan sign-off", state: "gate" },
+    ]);
+  });
+});
