 }
 
+/** One line of a run's trail: a stage it finished, the one under way, the next stage or the gate
+ *  that comes next. */
+export interface TrailStep {
+  text: string;
+  state: "done" | "now" | "next" | "gate";
+  /** The step under way's round in a loop, in words so it never reads as the step count. */
+  round?: string;
+}
+
+/** A running run at a glance: the stage before the one under way, that one (with its round in a
+ *  loop), and what comes after it: the gate it stops at, else the next stage. Skipped stages are
+ *  left out; a ticket with no stage under way has no trail. */
+export function trail(
+  t: Pick<TicketRow, "rail" | "phase" | "attention">,
+  me: Person | null,
+): TrailStep[] {
+  const path = stageModel(t, me).stages.filter((st) => st.state !== "skipped");
+  const at = path.findIndex((st) => st.state === "current" || st.state === "failed");
+  const cur = path[at];
+  if (!cur) return [];
+  const before = path[at - 1];
+  const after = path[at + 1];
+  const gate = cur.gate && cur.gate.state !== "passed" ? cur.gate : undefined;
+  const next: TrailStep[] = gate
+    ? [{ text: gate.label, state: "gate" }]
+    : after
+      ? [{ text: after.name, state: "next" }]
+      : [];
+  const now: TrailStep = cur.round
+    ? {
+        text: cur.name,
+        state: "now",
+        round: `Round ${String(cur.round.n)} of ${String(cur.round.of)}`,
+      }
+    : { text: cur.name, state: "now" };
+  return [...(before ? [{ text: before.name, state: "done" } as const] : []), now, ...next];
+}
