+++ b/web/src/features/queue/model.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from "vitest";
+
+import type { Attention, TicketRow } from "../../api/types";
+import { zones } from "./model";
+
+const NOW = Date.parse("2026-10-14T10:00:00Z");
+
+/** A ticket in the given state, since the given minutes ago. */
+const ticket = (key: string, attention: Attention, minutes: number): TicketRow => ({
+  key,
+  title: key,
+  type: "feature",
+  priority: "normal",
+  state: "open",
+  owner: null,
+  repo: null,
+  source: null,
+  phase: "build",
+  rail: [],
+  attention,
+  since: new Date(NOW - minutes * 60_000).toISOString(),
+  now: "",
+  plan: null,
+  messages: 0,
+  actions: [],
+  updated_at: new Date(NOW - minutes * 60_000).toISOString(),
+});
+
+const running = (run_id: number): Attention => ({
+  kind: "running",
+  run_id,
+  agent: "Builder",
+  step: "Running the tests",
+  progress: null,
+});
+
+describe("the agents' board", () => {
+  it("leads with the newest run at work and keeps the runs waiting for a runner last", () => {
+    const rows = [
+      ticket("A", running(1), 12),
+      ticket("B", { kind: "queued", run_id: 2 }, 1),
+      ticket("C", running(3), 3),
+      ticket("D", { kind: "inbox" }, 2),
+    ];
+    expect(zones(rows, null, NOW).agents.map((r) => r.t.key)).toEqual(["C", "A", "B"]);
+  });
+});
