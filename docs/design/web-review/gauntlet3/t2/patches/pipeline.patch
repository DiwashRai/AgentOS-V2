@@ -53,6 +54,42 @@ export function zones(rows: readonly TicketRow[], me: Person | null, now: number
   };
 }
 
+/** A stage of the pipeline: its name, the gate after it, and the runs at it now. */
+export interface PipeStage {
+  name: string;
+  gate?: { label: string; short: string };
+  runs: TicketRow[];
+}
+
+/** Where a run is: the stage at work (or stopped), else the last one it finished (a queued run
+ *  waits there for a runner). */
+function atOf(m: GlyphModel): string | undefined {
+  const at = m.stages.find((st) => st.state === "current" || st.state === "failed");
+  return (at ?? m.stages.findLast((st) => st.state === "done"))?.name;
+}
+
+/** The runs along their workflows' stages, in order: Inbox, then each stage a run's workflow has
+ *  (one every run skips left out; Done is the zone below), each run at the stage it is at, in the
+ *  zone's order. */
+export function pipeline(agents: readonly TicketRow[], me: Person | null): PipeStage[] {
+  const out: PipeStage[] = [];
+  const models = agents.map((t) => ({ t, m: stageModel(t, me) }));
+  for (const { m } of models) {
+    let after = -1;
+    for (const st of m.stages.slice(0, -1)) {
+      const i = out.findIndex((x) => x.name === st.name);
+      if (i >= 0) after = i;
+      else if (st.state !== "skipped") {
+        after += 1;
+        const gate = st.gate ? { gate: { label: st.gate.label, short: st.gate.short } } : {};
+        out.splice(after, 0, { name: st.name, runs: [], ...gate });
+      }
+    }
+  }
+  for (const { t, m } of models) out.find((x) => x.name === atOf(m))?.runs.push(t);
+  return out;
+}
+
 /** "2 yours · 4 across the team". */
 export function atWorkNote(z: Zones): string {
   return `${String(z.mine)} yours · ${String(Math.max(0, z.running + z.queued - z.mine))} across the team`;
