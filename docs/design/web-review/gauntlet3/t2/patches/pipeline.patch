--- /dev/null
+++ b/web/src/kit/Pipeline.module.css
@@ -0,0 +1,100 @@
+/* the pipeline: a column per stage, parted by a gap the gates' diamonds sit in; a stage with nothing
+   at it hugs its name (the widths the component sets, --cols) */
+.flow {
+  --gap: var(--sp-6);
+  display: grid;
+  grid-template-columns: var(--cols);
+  column-gap: var(--gap);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.stage {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+/* the track: the stepper's bar over each stage, a gate's diamond centred in the gap where its stage
+   ends, threading the two bars together */
+.bar {
+  position: relative;
+  display: block;
+  height: var(--line-3);
+  border-radius: var(--line-3);
+  background: var(--track);
+}
+.knot {
+  position: absolute;
+  top: calc(var(--line-3) / 2 - var(--sp-4) / 2);
+  right: calc(var(--gap) / -2 - var(--sp-4) / 2);
+  width: var(--sp-4);
+  height: var(--sp-4);
+  border-radius: var(--line-1);
+  transform: rotate(45deg);
+  background: var(--track);
+  box-shadow: inset 0 0 0 var(--line-mark) var(--rule-strong);
+}
+
+/* a stage's head under its bar: its name in ink, its count receding after it, the gate after the
+   stage at the head's end, under the diamond it names */
+.head {
+  display: flex;
+  align-items: baseline;
+  gap: var(--sp-4);
+  min-width: 0;
+  margin: var(--sp-4) 0 var(--sp-5);
+  white-space: nowrap;
+}
+.name {
+  display: flex;
+  align-items: baseline;
+  gap: var(--sp-3);
+  min-width: 0;
+  margin: 0;
+  overflow: hidden;
+  font-size: var(--fs-3);
+  font-weight: 500;
+  line-height: 1.4;
+  color: var(--ink-1);
+}
+.count {
+  font-weight: 400;
+  font-variant-numeric: tabular-nums;
+  color: var(--ink-3);
+}
+/* a stage with nothing at it recedes: its name muted, its bar the track's faintest */
+.stage[data-empty] .name {
+  color: var(--ink-3);
+}
+.stage:not([data-empty]) .bar {
+  background: var(--rule-strong);
+}
+.gate {
+  min-width: 0;
+  margin-left: auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  font-size: var(--fs-2);
+  line-height: 1.4;
+  color: var(--ink-3);
+}
+/* the stepper's small diamond before a gate's name */
+.gate::before {
+  content: "";
+  display: inline-block;
+  width: var(--sp-2);
+  height: var(--sp-2);
+  margin: 0 var(--sp-3) var(--line-1) 0;
+  border-radius: var(--line-1);
+  transform: rotate(45deg);
+  background: var(--rule-strong);
+}
+
+/* the runs at a stage, one under another */
+.items {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-4);
+  min-width: 0;
+}
diff --git a/web/src/kit/Pipeline.tsx b/web/src/kit/Pipeline.tsx
new file mode 100644
index 0000000..36bbdce
--- /dev/null
+++ b/web/src/kit/Pipeline.tsx
@@ -0,0 +1,59 @@
+// The runs in flight along a workflow's stages (My queue's Agents at work), left to right as the
+// work goes, in the stepper's own picture: a column per stage, its bar of the track over its name
+// and count, a gate's diamond in the gap where its stage ends and the gate's short name at the end
+// of the stage's head; under each, the runs at it now, one Card each. A stage with nothing at it
+// folds to its name, receding, so the stages at work get the room. It lays out what the screen
+// placed; it never decides where a run is.
+import type { ReactNode } from "react";
+
+import s from "./Pipeline.module.css";
+import { Tip } from "./tip";
+import { vars, width } from "./vars";
+
+export interface PipelineStage {
+  name: string;
+  /** The gate after it: its short name at the head's end, its whole name on hover. */
+  gate?: { label: string; short: string } | undefined;
+  /** What is at it now, one keyed Card each. */
+  items: readonly ReactNode[];
+}
+
+export interface PipelineProps {
+  /** The pipeline's accessible name. */
+  label: string;
+  stages: readonly PipelineStage[];
+}
+
+/** A stage at work takes an equal share; an empty one hugs its name. */
+const track = (st: PipelineStage) =>
+  st.items.length > 0 ? width("fill") : `fit-content(${width("md")})`;
+
+export function Pipeline({ label, stages }: PipelineProps) {
+  return (
+    <ol
+      className={s.flow}
+      aria-label={label}
+      style={vars({ "--cols": stages.map(track).join(" ") })}
+    >
+      {stages.map((st) => (
+        <li key={st.name} className={s.stage} data-empty={st.items.length === 0 || undefined}>
+          <span className={s.bar} aria-hidden="true">
+            {st.gate ? <i className={s.knot} /> : null}
+          </span>
+          <div className={s.head}>
+            <h3 className={s.name}>
+              {st.name}
+              <span className={s.count}>{st.items.length}</span>
+            </h3>
+            {st.gate ? (
+              <Tip text={st.gate.label}>
+                <span className={s.gate}>{st.gate.short}</span>
+              </Tip>
+            ) : null}
+          </div>
+          {st.items.length > 0 ? <div className={s.items}>{st.items}</div> : null}
+        </li>
+      ))}
+    </ol>
+  );
+}
