index 0000000..664e9a4
--- /dev/null
+++ b/web/src/features/queue/model.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+
+import type { Attention, RailStep, StepState, TicketRow } from "../../api/types";
+import { pipeline } from "./model";
+
+const NAMES = ["Plan", "Implement", "Lint", "Review", "Open a PR"];
+
+/** A run at stage `at` of a workflow whose Lint is off: the stages before it done, a running one's
+ *  current, a queued one's pending (it waits for a runner there). */
+function run(key: string, at: number, kind: "running" | "queued"): TicketRow {
+  const rail = NAMES.map((name, i): RailStep => {
+    const live = i === at && kind === "running";
+    const state: StepState =
+      name === "Lint" ? "skipped" : i < at ? "done" : live ? "current" : "pending";
+    const gate =
+      name === "Plan"
+        ? { label: "Plan sign-off", short: "Sign-off", state: "pending" as const }
+        : null;
+    return { stage_id: name, name, state, gate, round: null };
+  });
+  const attention: Attention =
+    kind === "running"
+      ? { kind, run_id: 1, agent: "Builder", step: "Testing", progress: null }
+      : { kind, run_id: 2 };
+  return {
+    key,
+    title: key,
+    type: "task",
+    priority: "normal",
+    state: "open",
+    owner: null,
+    repo: null,
+    source: null,
+    phase: "build",
+    rail,
+    attention,
+    since: "2026-10-14T10:00:00Z",
+    now: "",
+    plan: null,
+    messages: 0,
+    actions: [],
+    updated_at: "2026-10-14T10:00:00Z",
+  };
+}
+
+describe("the runs in flight along their stages", () => {
+  const stages = pipeline(
+    [run("A", 1, "running"), run("B", 0, "running"), run("C", 1, "queued")],
+    null,
+  );
+
+  it("lays the workflow's stages out in order, leaving out one every run skips", () => {
+    expect(stages.map((st) => st.name)).toEqual([
+      "Inbox",
+      "Plan",
+      "Implement",
+      "Review",
+      "Open a PR",
+    ]);
+  });
+  it("places every run once, at its stage: a queued one where it waits for a runner", () => {
+    expect(Object.fromEntries(stages.map((st) => [st.name, st.runs.map((t) => t.key)]))).toEqual({
+      Inbox: [],
+      Plan: ["B", "C"],
+      Implement: ["A"],
+      Review: [],
+      "Open a PR": [],
+    });
+  });
+  it("keeps the gate after a stage", () => {
+    expect(stages.find((st) => st.name === "Plan")?.gate?.short).toBe("Sign-off");
+  });
+});
